{
	"name": "anyq",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev:api": "pnpm --filter @anyq/api dev",
		"dev:web": "pnpm --filter @anyq/web dev",
		"build": "pnpm -r build",
		"test": "pnpm --filter @anyq/api test",
		"typecheck": "pnpm -r typecheck",
		"deploy:api": "pnpm --filter @anyq/api run deploy",
		"deploy:web": "pnpm --filter @anyq/web run deploy",
		"format": "vp fmt",
		"lint": "vp lint",
		"e2e": "pnpm --filter @anyq/e2e test",
		"deploy": "pnpm deploy:api && pnpm deploy:web"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || ^26.12.0"
	},
	"packageManager": "pnpm@12.14.0"
}
