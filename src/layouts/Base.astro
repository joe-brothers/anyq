---
import "../styles/styles.css";

interface Props {
	title: string;
	description?: string;
	bodyClass?: string;
	role?: string;
	noindex?: boolean;
}
const { title, description, bodyClass, role, noindex } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex" />}
		<link
			rel="icon"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231a1512'/%3E%3Cg fill='none' stroke='%23f5f0e8' stroke-width='4'%3E%3Ccircle cx='15.5' cy='15.5' r='7.5'/%3E%3Cpath d='M19 19l6 6'/%3E%3C/g%3E%3C/svg%3E"
		/>
		<script is:inline>
			try {
				document.documentElement.dataset.theme =
					localStorage.getItem("anyq-theme") ||
					(matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
			} catch (e) {}
		</script>
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
		/>
	</head>
	<body class={bodyClass} data-role={role}>
		<slot />
	</body>
</html>
