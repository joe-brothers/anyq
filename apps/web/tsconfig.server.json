{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noUncheckedIndexedAccess": true,
		"lib": ["es2024"],
		"types": []
	},
	"include": ["src/worker.ts", "src/server", "worker-configuration.d.ts"]
}
