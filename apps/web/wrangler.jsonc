{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "anyq-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-17",
	"assets": { "binding": "ASSETS", "directory": "./dist" },
	"observability": { "enabled": true },
	"routes": [{ "pattern": "anyq.joe-brothers.com", "custom_domain": true }],
	// /api/* 는 API Worker로 넘긴다. 같은 출처라 CORS가 없다.
	"services": [{ "binding": "API", "service": "anyq-api" }],
	// 로컬 개발에서만 쓴다(.dev.vars). 값이 있으면 바인딩 대신 이 주소로 넘긴다.
	"vars": { "API_ORIGIN": "" },
}
